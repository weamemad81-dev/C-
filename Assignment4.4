using System;

enum Season
{
    Spring,
    Summer,
    Autumn,
    Winter
}

class Program
{
    static void Main()
    {
        Console.Write("Enter season: ");
        string input = Console.ReadLine();

        if (Enum.TryParse(input, true, out Season season))
        {
            switch (season)
            {
                case Season.Spring:
                    Console.WriteLine("March to May");
                    break;

                case Season.Summer:
                    Console.WriteLine("June to August");
                    break;

                case Season.Autumn:
                    Console.WriteLine("September to November");
                    break;

                case Season.Winter:
                    Console.WriteLine("December to February");
                    break;
            }
        }
        else
        {
            Console.WriteLine("Invalid season");
        }
    }
}



using System;

[Flags]
enum Permissions
{
    None = 0,
    Read = 1,
    Write = 2,
    Delete = 4,
    Execute = 8
}

class Program
{
    static void Main()
    {
        Permissions permission = Permissions.Read | Permissions.Write;

        // Add Permission
        permission |= Permissions.Delete;

        Console.WriteLine("Permissions: " + permission);

        // Check Permission
        if ((permission & Permissions.Write) == Permissions.Write)
        {
            Console.WriteLine("Write permission exists");
        }

        // Remove Permission
        permission &= ~Permissions.Write;

        Console.WriteLine("After removing Write: " + permission);
    }
}



