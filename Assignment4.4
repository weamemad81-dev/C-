using System;
using System.Diagnostics;

class Program
{
    static void ByValue(int x)
    {
        x = 20;
    }

    static void ByReference(ref int x)
    {
        x = 20;
    }

    static void Main()
    {
        int a = 10;
        ByValue(a);
        Console.WriteLine(a); // 10

        int b = 10;
        ByReference(ref b);
        Console.WriteLine(b); // 20
    }
}


using System;

class Person
{
    public string Name;
}

[DebuggerDisplay($"{{{nameof(GetDebuggerDisplay)}(),nq}}")]
class Program
{
    static void ByValue(Person p)
    {
        p.Name = "Ahmed";
        p = new Person();
        p.Name = "Ali";
    }

    static void ByReference(ref Person p)
    {
        p = new Person();
        p.Name = "Ali";
    }

    static void Main()
    {
        Person person1 = new Person();
        person1.Name = "Omar";

        ByValue(person1);
        Console.WriteLine(person1.Name); // Ahmed

        Person person2 = new Person();
        person2.Name = "Omar";

        ByReference(ref person2);
        Console.WriteLine(person2.Name); // Ali
    }

    private string GetDebuggerDisplay()
    {
        return ToString();
    }
}


using System;

class Program
{
    static void Calculate(int a, int b, int c, int d, out int sum, out int subtract)
    {
        sum = a + b;
        subtract = c - d;
    }

    static void Main()
    {
        Console.Write("Enter first number: ");
        int a = int.Parse(Console.ReadLine());

        Console.Write("Enter second number: ");
        int b = int.Parse(Console.ReadLine());

        Console.Write("Enter third number: ");
        int c = int.Parse(Console.ReadLine());

        Console.Write("Enter fourth number: ");
        int d = int.Parse(Console.ReadLine());

        int sum, subtract;

        Calculate(a, b, c, d, out sum, out subtract);

        Console.WriteLine("Sum = " + sum);
        Console.WriteLine("Subtraction = " + subtract);
    }
}


using System;

class Program
{
    static int SumDigits(int number)
    {
        int sum = 0;

        while (number != 0)
        {
            sum += number % 10;
            number /= 10;
        }

        return sum;
    }

    static void Main()
    {
        Console.Write("Enter a number: ");
        int number = int.Parse(Console.ReadLine());

        int result = SumDigits(number);

        Console.WriteLine("The sum of the digits of the number "
                          + number + " is: " + result);
    }
}

